# ChatSystem 环境变量示例
#
# 服务端不读取 .env 文件；请在启动前把这些变量导入当前 shell：
#   cp .env.example .env
#   set -a; source .env; set +a
#
# 下方默认值与 scripts/init_db.sql 的本地演示配置一致。

# 监听端口
CHAT_PORT=8080

# 业务线程数（线程池大小）
CHAT_WORKERS=6

# MySQL 连接池大小
CHAT_DB_POOL=6

# MySQL 连接参数
CHAT_DB_HOST=127.0.0.1
CHAT_DB_PORT=3306
CHAT_DB_USER=chat_user
CHAT_DB_PASSWORD=chat_password
CHAT_DB_NAME=chat_db
